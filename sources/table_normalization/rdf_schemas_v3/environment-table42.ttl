@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix environment: <http://example.org/environment#> .

#-------------------------------------------
# Classes
#-------------------------------------------

environment:Animal a rdfs:Class ;
    rdfs:label "Animal"@en, "Животное"@ru ;
    rdfs:comment "Laboratory mouse with its genotype, experimental group and treatment."@en, "Лабораторная мышь с её генотипом, экспериментальной группой и препаратом."@ru .

environment:OpenFieldTest a rdfs:Class ;
    rdfs:label "Open field test"@en, "Тест открытого поля"@ru ;
    rdfs:comment "Time in the centre and latency to the centre of an animal in the open field test."@en, "Время в центре и задержка до выхода в центр животного в тесте открытого поля."@ru .

#-------------------------------------------
# Object Properties
#-------------------------------------------

environment:hasOpenFieldTest a rdf:Property ;
    rdfs:domain environment:Animal ;
    rdfs:range environment:OpenFieldTest ;
    rdfs:label "Open field test"@en, "Тест открытого поля"@ru ;
    rdfs:comment "Links an animal with its open field test results."@en, "Связывает животное с его результатами теста открытого поля."@ru .

#-------------------------------------------
# Datatype Properties
#-------------------------------------------

environment:animalId a rdf:Property ;
    rdfs:domain environment:Animal ;
    rdfs:range xsd:string ;
    rdfs:label "Animal identifier"@en, "Идентификатор животного"@ru ;
    rdfs:comment "Identifier of the animal in the experiment."@en, "Идентификатор животного в эксперименте."@ru .

environment:genotype a rdf:Property ;
    rdfs:domain environment:Animal ;
    rdfs:range xsd:string ;
    rdfs:label "Genotype"@en, "Генотип"@ru ;
    rdfs:comment "Genotype of the animal, such as wild type or FGF2 knockout."@en, "Генотип животного, например дикий тип или нокаут по гену FGF2."@ru .

environment:group a rdf:Property ;
    rdfs:domain environment:Animal ;
    rdfs:range xsd:string ;
    rdfs:label "Group"@en, "Группа"@ru ;
    rdfs:comment "Experimental group to which the animal belongs, control or stress."@en, "Экспериментальная группа животного: контроль или стресс."@ru .

environment:treatment a rdf:Property ;
    rdfs:domain environment:Animal ;
    rdfs:range xsd:string ;
    rdfs:label "Treatment"@en, "Препарат"@ru ;
    rdfs:comment "Pharmacological treatment applied to the animal, vehicle or fluoxetine."@en, "Препарат, который получало животное: растворитель или флуоксетин."@ru .

environment:timeCentre a rdf:Property ;
    rdfs:domain environment:OpenFieldTest ;
    rdfs:range xsd:decimal ;
    rdfs:label "Time in centre (s)"@en, "Время в центре (с)"@ru ;
    rdfs:comment "Duration the animal spent in the central area of the arena in seconds."@en, "Время, проведённое животным в центральной зоне арены, в секундах."@ru .

environment:latencyCentre a rdf:Property ;
    rdfs:domain environment:OpenFieldTest ;
    rdfs:range xsd:decimal ;
    rdfs:label "Latency to centre (s)"@en, "Задержка до центра (с)"@ru ;
    rdfs:comment "Time before the animal first entered the central area in seconds."@en, "Время до первого выхода животного в центральную зону в секундах."@ru .
