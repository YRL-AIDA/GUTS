@prefix emp: <http://example.org/employment#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# ==================== Classes ====================

emp:EmploymentStatistics a rdfs:Class ;
    rdfs:label "Employment statistics"@en, "Статистика занятости"@ru ;
    rdfs:comment "Annual statistics on employment of the civilian non-institutional population of the United States in various demographic groups with various details by category"@en, "Ежегодные статистические данные занятости гражданского неинституционального населения США в различных демографических группах с разной детализацией по категориям"@ru .

# ==================== Datatype Properties ====================

emp:year a rdf:Property ;
    rdfs:domain emp:EmploymentStatistics ;
    rdfs:range xsd:gYear ;
    rdfs:label "Year"@en, "Год"@ru ;
    rdfs:comment "The calendar year for which the statistic is reported"@en, "Календарный год, за который приводятся статистические данные"@ru .

emp:sexAgeGroup a rdf:Property ;
    rdfs:domain emp:EmploymentStatistics ;
    rdfs:range xsd:string ;
    rdfs:label "Sex and age group"@en, "Пол и возрастная группа"@ru ;
    rdfs:comment "Combined attribute of sex and age group"@en, "Совокупный признак пола и возрастной группы"@ru .

emp:ethnicity a rdf:Property ;
    rdfs:domain emp:EmploymentStatistics ;
    rdfs:range xsd:string ;
    rdfs:label "Ethnicity"@en, "Этническая группа"@ru ;
    rdfs:comment "Ethnicity category"@en, "Категория этнической группы"@ru .

emp:employed a rdf:Property ;
    rdfs:domain emp:EmploymentStatistics ;
    rdfs:range xsd:integer ;
    rdfs:label "Employed"@en, "Численность занятых"@ru ;
    rdfs:comment "The total number of employed persons (in thousands)"@en, "Общее число занятых (в тысячах)"@ru .

emp:unemployed a rdf:Property ;
    rdfs:domain emp:EmploymentStatistics ;
    rdfs:range xsd:integer ;
    rdfs:label "Unemployed"@en, "Число безработных"@ru ;
    rdfs:comment "The number of unemployed persons (in thousands)"@en, "Число безработных (в тысячах)"@ru .

emp:notInLaborForce a rdf:Property ;
    rdfs:domain emp:EmploymentStatistics ;
    rdfs:range xsd:integer ;
    rdfs:label "Not in labor force"@en, "Не входит в состав рабочей силы"@ru ;
    rdfs:comment "The number of persons not in the labor force (in thousands)"@en, "Число лиц, не входящих в состав рабочей силы (в тысячах)"@ru .
