@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix environment: <http://example.org/environment#> .

#-------------------------------------------
# Classes
#-------------------------------------------

environment:Animal a rdfs:Class ;
    rdfs:label "Animal"@en, "Животное"@ru ;
    rdfs:comment "Laboratory mouse with its genotype, experimental group and treatment."@en, "Лабораторная мышь с её генотипом, экспериментальной группой и препаратом."@ru .

environment:GeneExpression a rdfs:Class ;
    rdfs:label "Gene expression"@en, "Экспрессия генов"@ru ;
    rdfs:comment "Fold change of GR and FGF2 gene expression in an animal."@en, "Кратность изменения экспрессии генов GR и FGF2 у животного."@ru .

#-------------------------------------------
# Object Properties
#-------------------------------------------

environment:hasGeneExpression a rdf:Property ;
    rdfs:domain environment:Animal ;
    rdfs:range environment:GeneExpression ;
    rdfs:label "Gene expression"@en, "Экспрессия генов"@ru ;
    rdfs:comment "Links an animal with its gene expression measurements."@en, "Связывает животное с его измерениями экспрессии генов."@ru .

#-------------------------------------------
# Datatype Properties
#-------------------------------------------

environment:animalId a rdf:Property ;
    rdfs:domain environment:Animal ;
    rdfs:range xsd:string ;
    rdfs:label "Animal identifier"@en, "Идентификатор животного"@ru ;
    rdfs:comment "Identifier of the animal in the experiment."@en, "Идентификатор животного в эксперименте."@ru .

environment:genotype a rdf:Property ;
    rdfs:domain environment:Animal ;
    rdfs:range xsd:string ;
    rdfs:label "Genotype"@en, "Генотип"@ru ;
    rdfs:comment "Genotype of the animal, such as wild type or FGF2 knockout."@en, "Генотип животного, например дикий тип или нокаут по гену FGF2."@ru .

environment:group a rdf:Property ;
    rdfs:domain environment:Animal ;
    rdfs:range xsd:string ;
    rdfs:label "Group"@en, "Группа"@ru ;
    rdfs:comment "Experimental group to which the animal belongs, control or stress."@en, "Экспериментальная группа животного: контроль или стресс."@ru .

environment:treatment a rdf:Property ;
    rdfs:domain environment:Animal ;
    rdfs:range xsd:string ;
    rdfs:label "Treatment"@en, "Препарат"@ru ;
    rdfs:comment "Pharmacological treatment applied to the animal, vehicle or fluoxetine."@en, "Препарат, который получало животное: растворитель или флуоксетин."@ru .

environment:grFoldChange a rdf:Property ;
    rdfs:domain environment:GeneExpression ;
    rdfs:range xsd:decimal ;
    rdfs:label "GR fold change"@en, "Кратность изменения GR"@ru ;
    rdfs:comment "Fold change in the expression of the glucocorticoid receptor gene GR."@en, "Кратность изменения экспрессии гена глюкокортикоидного рецептора GR."@ru .

environment:fgf2FoldChange a rdf:Property ;
    rdfs:domain environment:GeneExpression ;
    rdfs:range xsd:decimal ;
    rdfs:label "FGF2 fold change"@en, "Кратность изменения FGF2"@ru ;
    rdfs:comment "Fold change in the expression of the fibroblast growth factor 2 gene FGF2."@en, "Кратность изменения экспрессии гена фактора роста фибробластов 2 FGF2."@ru .
