@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix science: <http://example.org/science#> .

#-------------------------------------------
# Classes
#-------------------------------------------

science:ExperimentalGroup a rdfs:Class ;
    rdfs:label "Experimental group"@en, "Экспериментальная группа"@ru ;
    rdfs:comment "Experimental group defined by its set, infection status and condition."@en, "Экспериментальная группа, заданная набором, статусом заражения и условием опыта."@ru .

science:ImmuneMarker a rdfs:Class ;
    rdfs:label "Immune marker"@en, "Иммунный маркер"@ru ;
    rdfs:comment "Measured value in an experimental group for an experiment and replicate."@en, "Измеренное значение в экспериментальной группе для опыта и повтора."@ru .

#-------------------------------------------
# Object Properties
#-------------------------------------------

science:hasImmuneMarker a rdf:Property ;
    rdfs:domain science:ExperimentalGroup ;
    rdfs:range science:ImmuneMarker ;
    rdfs:label "Immune marker values"@en, "Значения маркера"@ru ;
    rdfs:comment "Links an experimental group with the values measured in it."@en, "Связывает экспериментальную группу с измеренными в ней значениями."@ru .

#-------------------------------------------
# Datatype Properties
#-------------------------------------------

science:set a rdf:Property ;
    rdfs:domain science:ExperimentalGroup ;
    rdfs:range xsd:string ;
    rdfs:label "Set"@en, "Набор"@ru ;
    rdfs:comment "Identifier of the set, such as Set1."@en, "Обозначение набора, например Set1."@ru .

science:infectionStatus a rdf:Property ;
    rdfs:domain science:ExperimentalGroup ;
    rdfs:range xsd:string ;
    rdfs:label "Infection status"@en, "Статус заражения"@ru ;
    rdfs:comment "Infection status as given in the table: Uninf or Infected."@en, "Статус заражения, как в таблице: Uninf или Infected."@ru .

science:condition a rdf:Property ;
    rdfs:domain science:ExperimentalGroup ;
    rdfs:range xsd:string ;
    rdfs:label "Condition"@en, "Условие"@ru ;
    rdfs:comment "Experimental condition as given in the table, such as DC + SAG."@en, "Условие опыта, как в таблице, например DC + SAG."@ru .

science:experiment a rdf:Property ;
    rdfs:domain science:ImmuneMarker ;
    rdfs:range xsd:string ;
    rdfs:label "Experiment"@en, "Опыт"@ru ;
    rdfs:comment "Identifier of the independent experiment, such as Expt-1."@en, "Обозначение независимого опыта, например Expt-1."@ru .

science:replicate a rdf:Property ;
    rdfs:domain science:ImmuneMarker ;
    rdfs:range xsd:string ;
    rdfs:label "Replicate"@en, "Повтор"@ru ;
    rdfs:comment "Identifier of the replicate within the experiment."@en, "Обозначение повтора внутри опыта."@ru .

science:measurementValue a rdf:Property ;
    rdfs:domain science:ImmuneMarker ;
    rdfs:range xsd:decimal ;
    rdfs:label "Measured value"@en, "Измеренное значение"@ru ;
    rdfs:comment "Measured value for the group, experiment and replicate."@en, "Измеренное значение для группы, опыта и повтора."@ru .
