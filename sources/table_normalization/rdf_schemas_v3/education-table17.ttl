@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix education: <http://example.org/education#> .

#-------------------------------------------
# Classes
#-------------------------------------------

education:EducationDemographic a rdfs:Class ;
    rdfs:label "Education demographic"@en, "Демографические характеристики по уровню образования"@ru ;
    rdfs:comment "Statistical data on the demographic composition of students in the U.S. education system, detailed by demographic dimension, category, and metric type."@en, "Статистические данные о демографическом составе учащихся в системе образования США с детализацией по демографическому измерению, категории и типу метрики."@ru .

education:State a rdfs:Class ;
    rdfs:label "US state or national total"@en, "Штат США или показатель по стране"@ru ;
    rdfs:comment "A U.S. state or the United States as a whole."@en, "Штат США либо Соединённые Штаты в целом."@ru .

#-------------------------------------------
# Object Properties
#-------------------------------------------

education:hasStatistics a rdf:Property ;
    rdfs:domain education:State ;
    rdfs:range education:EducationDemographic ;
    rdfs:label "Demographic statistics record"@en, "Запись демографической статистики"@ru ;
    rdfs:comment "Links a state with demographic statistics observed for that state."@en, "Связывает штат с демографической статистикой, наблюдаемой по этому штату."@ru .

#-------------------------------------------
# Datatype Properties
#-------------------------------------------

education:state a rdf:Property ;
    rdfs:domain education:State ;
    rdfs:range xsd:string ;
    rdfs:label "State or aggregated region"@en, "Штат или агрегированный регион"@ru ;
    rdfs:comment "U.S. state or aggregated region for which the statistic is reported."@en, "Штат США или агрегированный регион, для которого представлена статистика."@ru .

education:schoolsNumber a rdf:Property ;
    rdfs:domain education:State ;
    rdfs:range xsd:integer ;
    rdfs:label "Number of reporting schools"@en, "Количество отчитавшихся школ"@ru ;
    rdfs:comment "Number of schools that reported data for the state."@en, "Количество школ, предоставивших данные по штату."@ru .

education:percentSchoolsReporting a rdf:Property ;
    rdfs:domain education:State ;
    rdfs:range xsd:decimal ;
    rdfs:label "Share of reporting schools"@en, "Доля отчитавшихся школ"@ru ;
    rdfs:comment "Percentage of schools in the state that reported data."@en, "Процент школ штата, предоставивших данные."@ru .

education:demographicDimension a rdf:Property ;
    rdfs:domain education:EducationDemographic ;
    rdfs:range xsd:string ;
    rdfs:label "Demographic dimension type"@en, "Тип демографического измерения"@ru ;
    rdfs:comment "Type of the demographic dimension."@en, "Тип демографического измерения."@ru .

education:demographicCategory a rdf:Property ;
    rdfs:domain education:EducationDemographic ;
    rdfs:range xsd:string ;
    rdfs:label "Demographic category value"@en, "Значение демографической категории"@ru ;
    rdfs:comment "Specific category within the demographic dimension."@en, "Конкретная категория внутри демографического измерения."@ru .

education:number a rdf:Property ;
    rdfs:domain education:EducationDemographic ;
    rdfs:range xsd:integer ;
    rdfs:label "Numeric quantity"@en, "Числовое количество"@ru ;
    rdfs:comment "Numeric value representing the quantity."@en, "Числовое значение, представляющее количество."@ru .
