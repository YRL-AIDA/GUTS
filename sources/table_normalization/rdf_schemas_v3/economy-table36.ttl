@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix economy: <http://example.org/economy#> .

#-------------------------------------------
# Classes
#-------------------------------------------

economy:Product a rdfs:Class ;
    rdfs:label "Product"@en, "Продукт"@ru ;
    rdfs:comment "A product with material."@en, "Продукт с информацией о материале."@ru .

economy:Labour a rdfs:Class ;
    rdfs:label "Labour"@en, "Труд"@ru ;
    rdfs:comment "A labour cost."@en, "Затраты на оплату труда."@ru .

economy:PriceList a rdfs:Class ;
    rdfs:label "Price list"@en, "Прайс-лист"@ru ;
    rdfs:comment "A price list with mark-up price information."@en, "Прайс-лист с информацией о цене с наценкой."@ru .

#-------------------------------------------
# Object Properties
#-------------------------------------------

economy:hasLabourCost a rdf:Property ;
    rdfs:domain economy:Product ;
    rdfs:range economy:Labour ;
    rdfs:label "Labour cost"@en, "Затраты на оплату труда"@ru ;
    rdfs:comment "Labor costs incurred in the production of a product."@en, "Затраты на оплату труда при производстве продукта."@ru .

economy:hasPriceList a rdf:Property ;
    rdfs:domain economy:Product ;
    rdfs:range economy:PriceList ;
    rdfs:label "Product price list"@en, "Прайс-лист продукта"@ru ;
    rdfs:comment "Price list for products."@en, "Прайс-лист с ценами на продукты."@ru .

#-------------------------------------------
# Datatype Properties
#-------------------------------------------

economy:productName a rdf:Property ;
    rdfs:domain economy:Product ;
    rdfs:range xsd:string ;
    rdfs:label "Product name"@en, "Название продукта"@ru ;
    rdfs:comment "Name of the construction product."@en, "Название строительного продукта."@ru .

economy:blankSizeIn a rdf:Property ;
    rdfs:domain economy:Product ;
    rdfs:range xsd:decimal ;
    rdfs:label "Blank size (in)"@en, "Размер заготовки (дюймы)"@ru ;
    rdfs:comment "Blank size in inches."@en, "Размер заготовки в дюймах."@ru .

economy:materialType a rdf:Property ;
    rdfs:domain economy:Product ;
    rdfs:range xsd:string ;
    rdfs:label "Type of material"@en, "Тип материала"@ru ;
    rdfs:comment "Product material type."@en, "Тип материала продукта."@ru .

economy:costLinearFoot a rdf:Property ;
    rdfs:domain economy:Product ;
    rdfs:range xsd:decimal ;
    rdfs:label "Cost / linear foot"@en, "Стоимость за погонный фут"@ru ;
    rdfs:comment "Material cost per linear foot."@en, "Стоимость материала за погонный фут."@ru .

economy:lengthFeet a rdf:Property ;
    rdfs:domain economy:Product ;
    rdfs:range xsd:integer ;
    rdfs:label "Length feet"@en, "Длина, футы"@ru ;
    rdfs:comment "Length in feet."@en, "Длина в футах."@ru .

economy:lengthInches a rdf:Property ;
    rdfs:domain economy:Product ;
    rdfs:range xsd:integer ;
    rdfs:label "Length inches"@en, "Длина, дюймы"@ru ;
    rdfs:comment "Additional length in inches."@en, "Дополнительная длина в дюймах."@ru .

economy:numberOfSteps a rdf:Property ;
    rdfs:domain economy:Labour ;
    rdfs:range xsd:integer ;
    rdfs:label "Number of steps"@en, "Количество шагов"@ru ;
    rdfs:comment "Number of labour steps."@en, "Количество шагов трудового процесса."@ru .

economy:laborCost a rdf:Property ;
    rdfs:domain economy:Labour ;
    rdfs:range xsd:decimal ;
    rdfs:label "Labor cost"@en, "Стоимость труда"@ru ;
    rdfs:comment "Labor cost for product manufacturing."@en, "Стоимость труда на изготовление продукта."@ru .

economy:price a rdf:Property ;
    rdfs:domain economy:PriceList ;
    rdfs:range xsd:decimal ;
    rdfs:label "Price"@en, "Цена"@ru ;
    rdfs:comment "Price with a markup for a product."@en, "Цена с наценкой для продукта."@ru .
