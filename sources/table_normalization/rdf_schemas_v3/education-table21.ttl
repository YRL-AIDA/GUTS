@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix education: <http://example.org/education#> .

#-------------------------------------------
# Classes
#-------------------------------------------

education:HighSchool a rdfs:Class ;
    rdfs:label "High school"@en, "Старшая школа"@ru ;
    rdfs:comment "Educational institution classified as a transfer high school."@en, "Образовательное учреждение, классифицируемое как старшая школа переводного типа."@ru .

education:StudentPerformance a rdfs:Class ;
    rdfs:label "Student performance"@en, "Успеваемость студентов"@ru ;
    rdfs:comment "Student achievement data, including performance score and graduation metrics, together with comparison ranges against similar schools and city benchmarks."@en, "Данные об успеваемости учащихся, включая балл результативности и показатели выпуска, а также диапазоны сравнения с аналогичными школами и городскими ориентирами."@ru .

#-------------------------------------------
# Object Properties
#-------------------------------------------

education:hasPerformanceAssessment a rdf:Property ;
    rdfs:domain education:HighSchool ;
    rdfs:range education:StudentPerformance ;
    rdfs:label "Performance assessment"@en, "Оценка успеваемости"@ru ;
    rdfs:comment "Links a high school with an assessment value for a performance dimension."@en, "Связывает старшую школу с оценкой по показателю успеваемости."@ru .

#-------------------------------------------
# Datatype Properties
#-------------------------------------------

education:dbn a rdf:Property ;
    rdfs:domain education:HighSchool ;
    rdfs:range xsd:string ;
    rdfs:label "DBN school code"@en, "Код школы DBN"@ru ;
    rdfs:comment "Unique alphanumeric DBN identifier of the school."@en, "Уникальный буквенно-цифровой идентификатор школы в формате DBN."@ru .

education:schoolName a rdf:Property ;
    rdfs:domain education:HighSchool ;
    rdfs:range xsd:string ;
    rdfs:label "Official school name"@en, "Официальное наименование школы"@ru ;
    rdfs:comment "Official name of the educational institution."@en, "Официальное наименование образовательного учреждения."@ru .

education:performanceScore a rdf:Property ;
    rdfs:domain education:HighSchool ;
    rdfs:range xsd:decimal ;
    rdfs:label "Overall performance score"@en, "Общий балл успеваемости"@ru ;
    rdfs:comment "Overall numeric performance score for the school."@en, "Общий числовой показатель успеваемости школы."@ru .

education:performanceGrade a rdf:Property ;
    rdfs:domain education:HighSchool ;
    rdfs:range xsd:string ;
    rdfs:label "Performance letter grade"@en, "Буквенная оценка успеваемости"@ru ;
    rdfs:comment "Letter grade summarizing the performance score (A, B, C, D, or F)."@en, "Буквенная оценка, обобщающая балл успеваемости (A, B, C, D или F)."@ru .

education:dimension a rdf:Property ;
    rdfs:domain education:StudentPerformance ;
    rdfs:range xsd:string ;
    rdfs:label "Graduation rate dimension"@en, "Показатель доли выпускников"@ru ;
    rdfs:comment "Type of graduation-rate metric being reported."@en, "Тип показателя доли выпускников, по которому приводятся данные."@ru .

education:dimensionValue a rdf:Property ;
    rdfs:domain education:StudentPerformance ;
    rdfs:range xsd:decimal ;
    rdfs:label "Dimension value"@en, "Значение показателя"@ru ;
    rdfs:comment "Value recorded for the school on the given dimension."@en, "Значение, зафиксированное для школы по данному показателю."@ru .

education:comparisonScope a rdf:Property ;
    rdfs:domain education:StudentPerformance ;
    rdfs:range xsd:string ;
    rdfs:label "Comparison reference group"@en, "Группа для сравнения"@ru ;
    rdfs:comment "Reference group used for comparison, such as peer schools or the city as a whole."@en, "Группа, используемая для сравнения, например аналогичные школы или город в целом."@ru .

education:minRange a rdf:Property ;
    rdfs:domain education:StudentPerformance ;
    rdfs:range xsd:decimal ;
    rdfs:label "Minimum range bound"@en, "Нижняя граница диапазона"@ru ;
    rdfs:comment "Lower bound of the value range for the given dimension and comparison scope."@en, "Нижняя граница диапазона значений для заданного показателя и области сравнения."@ru .

education:maxRange a rdf:Property ;
    rdfs:domain education:StudentPerformance ;
    rdfs:range xsd:decimal ;
    rdfs:label "Maximum range bound"@en, "Верхняя граница диапазона"@ru ;
    rdfs:comment "Upper bound of the value range for the given dimension and comparison scope."@en, "Верхняя граница диапазона значений для заданного показателя и области сравнения."@ru .
