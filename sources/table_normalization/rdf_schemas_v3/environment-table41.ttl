@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix environment: <http://example.org/environment#> .

#-------------------------------------------
# Classes
#-------------------------------------------

environment:Animal a rdfs:Class ;
    rdfs:label "Animal"@en, "Животное"@ru ;
    rdfs:comment "Laboratory mouse with its genotype, experimental group and treatment."@en, "Лабораторная мышь с её генотипом, экспериментальной группой и препаратом."@ru .

environment:ElevatedPlusMaze a rdfs:Class ;
    rdfs:label "Elevated plus maze"@en, "Приподнятый крестообразный лабиринт"@ru ;
    rdfs:comment "Time and distance of an animal in the open arms of the elevated plus maze."@en, "Время и путь животного в открытых рукавах приподнятого крестообразного лабиринта."@ru .

#-------------------------------------------
# Object Properties
#-------------------------------------------

environment:hasElevatedPlusMaze a rdf:Property ;
    rdfs:domain environment:Animal ;
    rdfs:range environment:ElevatedPlusMaze ;
    rdfs:label "Elevated plus maze"@en, "Приподнятый крестообразный лабиринт"@ru ;
    rdfs:comment "Links an animal with its elevated plus maze results."@en, "Связывает животное с его результатами теста в приподнятом крестообразном лабиринте."@ru .

#-------------------------------------------
# Datatype Properties
#-------------------------------------------

environment:animalId a rdf:Property ;
    rdfs:domain environment:Animal ;
    rdfs:range xsd:string ;
    rdfs:label "Animal identifier"@en, "Идентификатор животного"@ru ;
    rdfs:comment "Identifier of the animal in the experiment."@en, "Идентификатор животного в эксперименте."@ru .

environment:genotype a rdf:Property ;
    rdfs:domain environment:Animal ;
    rdfs:range xsd:string ;
    rdfs:label "Genotype"@en, "Генотип"@ru ;
    rdfs:comment "Genotype of the animal, such as wild type or FGF2 knockout."@en, "Генотип животного, например дикий тип или нокаут по гену FGF2."@ru .

environment:group a rdf:Property ;
    rdfs:domain environment:Animal ;
    rdfs:range xsd:string ;
    rdfs:label "Group"@en, "Группа"@ru ;
    rdfs:comment "Experimental group to which the animal belongs, control or stress."@en, "Экспериментальная группа животного: контроль или стресс."@ru .

environment:treatment a rdf:Property ;
    rdfs:domain environment:Animal ;
    rdfs:range xsd:string ;
    rdfs:label "Treatment"@en, "Препарат"@ru ;
    rdfs:comment "Pharmacological treatment applied to the animal, vehicle or fluoxetine."@en, "Препарат, который получало животное: растворитель или флуоксетин."@ru .

environment:timeOpenArms a rdf:Property ;
    rdfs:domain environment:ElevatedPlusMaze ;
    rdfs:range xsd:decimal ;
    rdfs:label "Time in open arms (s)"@en, "Время в открытых рукавах (с)"@ru ;
    rdfs:comment "Duration the animal spent in the open arms of the maze in seconds."@en, "Время, проведённое животным в открытых рукавах лабиринта, в секундах."@ru .

environment:openDistancePercent a rdf:Property ;
    rdfs:domain environment:ElevatedPlusMaze ;
    rdfs:range xsd:decimal ;
    rdfs:label "Open arm distance (%)"@en, "Путь в открытых рукавах (%)"@ru ;
    rdfs:comment "Share of the distance travelled in the open arms in the total distance, in percent."@en, "Доля пути в открытых рукавах от всего пройденного пути в процентах."@ru .

environment:totalDistance a rdf:Property ;
    rdfs:domain environment:ElevatedPlusMaze ;
    rdfs:range xsd:decimal ;
    rdfs:label "Total distance (m)"@en, "Общий путь (м)"@ru ;
    rdfs:comment "Total distance travelled by the animal during the test in metres."@en, "Весь путь, пройденный животным во время теста, в метрах."@ru .
