@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix economy: <http://example.org/economy#> .

#-------------------------------------------
# Classes
#-------------------------------------------

economy:Customer a rdfs:Class ;
    rdfs:label "Customer"@en, "Клиент"@ru ;
    rdfs:comment "Customer of the company with its credit terms."@en, "Клиент компании с его кредитными условиями."@ru .

economy:Branch a rdfs:Class ;
    rdfs:label "Branch"@en, "Филиал"@ru ;
    rdfs:comment "Branch of the company identified by its code."@en, "Филиал компании, обозначенный кодом."@ru .

economy:OutstandingBill a rdfs:Class ;
    rdfs:label "Outstanding bill"@en, "Неоплаченный счёт"@ru ;
    rdfs:comment "Invoice issued to a customer that is not yet fully paid."@en, "Счёт, выставленный клиенту и ещё не оплаченный полностью."@ru .

#-------------------------------------------
# Object Properties
#-------------------------------------------

economy:hasCustomerBills a rdf:Property ;
    rdfs:domain economy:Customer ;
    rdfs:range economy:OutstandingBill ;
    rdfs:label "Customer bills"@en, "Счета клиента"@ru ;
    rdfs:comment "Links a customer with its outstanding bills."@en, "Связывает клиента с его неоплаченными счетами."@ru .

economy:hasOutstandingBill a rdf:Property ;
    rdfs:domain economy:Branch ;
    rdfs:range economy:OutstandingBill ;
    rdfs:label "Outstanding bills"@en, "Неоплаченный счета"@ru ;
    rdfs:comment "Links a specific point of sale within a branch to the invoices issued there."@en, "Связывает конкретную точку продаж из филиала с выписанными в ней счетами."@ru .

#-------------------------------------------
# Datatype Properties
#-------------------------------------------

economy:customerName a rdf:Property ;
    rdfs:domain economy:Customer ;
    rdfs:range xsd:string ;
    rdfs:label "Customer name"@en, "Название клиента"@ru ;
    rdfs:comment "Name of the customer entity."@en, "Название организации-клиента."@ru .

economy:accountCreditDays a rdf:Property ;
    rdfs:domain economy:Customer ;
    rdfs:range xsd:integer ;
    rdfs:label "Account credit days"@en, "Кредитные дни"@ru ;
    rdfs:comment "Number of days allowed for payment under the customer credit agreement."@en, "Число дней на оплату по кредитному соглашению с клиентом."@ru .

economy:accountCreditLimit a rdf:Property ;
    rdfs:domain economy:Customer ;
    rdfs:range xsd:decimal ;
    rdfs:label "Account credit limit"@en, "Кредитный лимит"@ru ;
    rdfs:comment "Maximum outstanding balance allowed for the customer under the credit agreement."@en, "Наибольший допустимый долг клиента по кредитному соглашению."@ru .

economy:branchCode a rdf:Property ;
    rdfs:domain economy:Branch ;
    rdfs:range xsd:string ;
    rdfs:label "Branch code"@en, "Код филиала"@ru ;
    rdfs:comment "Short alphanumeric identifier of the branch."@en, "Краткий буквенно-цифровой код филиала."@ru .

economy:branchName a rdf:Property ;
    rdfs:domain economy:Branch ;
    rdfs:range xsd:string ;
    rdfs:label "Branch name"@en, "Название филиала"@ru ;
    rdfs:comment "Full name of the branch."@en, "Полное название филиала."@ru .

economy:outletCode a rdf:Property ;
    rdfs:domain economy:Branch ;
    rdfs:range xsd:string ;
    rdfs:label "Outlet code"@en, "Код точки продаж"@ru ;
    rdfs:comment "System identifier of the sales outlet."@en, "Системный идентификатор точки продаж."@ru .

economy:voucher a rdf:Property ;
    rdfs:domain economy:OutstandingBill ;
    rdfs:range xsd:string ;
    rdfs:label "Voucher"@en, "Номер документа"@ru ;
    rdfs:comment "Identifier of the voucher in the accounting system."@en, "Номер документа в учётной системе."@ru .

economy:date a rdf:Property ;
    rdfs:domain economy:OutstandingBill ;
    rdfs:range xsd:date ;
    rdfs:label "Date"@en, "Дата"@ru ;
    rdfs:comment "Date when the invoice was issued."@en, "Дата выставления счёта."@ru .

economy:invoiceAmount a rdf:Property ;
    rdfs:domain economy:OutstandingBill ;
    rdfs:range xsd:decimal ;
    rdfs:label "Invoice amount"@en, "Сумма счёта"@ru ;
    rdfs:comment "Original amount of the invoice in currency units."@en, "Исходная сумма счёта в денежных единицах."@ru .

economy:balanceAmount a rdf:Property ;
    rdfs:domain economy:OutstandingBill ;
    rdfs:range xsd:decimal ;
    rdfs:label "Balance amount"@en, "Остаток"@ru ;
    rdfs:comment "Remaining unpaid amount of the invoice in currency units."@en, "Неоплаченный остаток по счёту в денежных единицах."@ru .

economy:dueDate a rdf:Property ;
    rdfs:domain economy:OutstandingBill ;
    rdfs:range xsd:date ;
    rdfs:label "Due date"@en, "Срок оплаты"@ru ;
    rdfs:comment "Payment due date for the invoice."@en, "Срок оплаты счёта."@ru .

economy:salesTypeName a rdf:Property ;
    rdfs:domain economy:OutstandingBill ;
    rdfs:range xsd:string ;
    rdfs:label "Sales type"@en, "Вид продаж"@ru ;
    rdfs:comment "Name of the sales category, such as wholesale."@en, "Название вида продаж, например оптовые продажи."@ru .

economy:employeeName a rdf:Property ;
    rdfs:domain economy:OutstandingBill ;
    rdfs:range xsd:string ;
    rdfs:label "Employee name"@en, "Сотрудник"@ru ;
    rdfs:comment "Name of the employee responsible for the sale."@en, "Имя сотрудника, оформившего продажу."@ru .

economy:days a rdf:Property ;
    rdfs:domain economy:OutstandingBill ;
    rdfs:range xsd:integer ;
    rdfs:label "Days"@en, "Дни"@ru ;
    rdfs:comment "Number of days counted from the invoice date, as given in the source table."@en, "Число дней, отсчитанное от даты счёта, как в исходной таблице."@ru .
