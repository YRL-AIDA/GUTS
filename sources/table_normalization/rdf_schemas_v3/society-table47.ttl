@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix society: <http://example.org/society#> .

#-------------------------------------------
# Classes
#-------------------------------------------

society:HealthcareIntervention a rdfs:Class ;
    rdfs:label "Healthcare intervention"@en, "Медицинское вмешательство"@ru ;
    rdfs:comment "Maternal, newborn or child health intervention of the LiST model, such as antenatal care or a vaccine."@en, "Вмешательство модели LiST в области здоровья матерей, новорождённых и детей, например наблюдение беременных или вакцинация."@ru .

society:MitigationStrategy a rdfs:Class ;
    rdfs:label "Mitigation strategy"@en, "Стратегия смягчения"@ru ;
    rdfs:comment "Measure taken to keep essential health services running safely during the COVID-19 pandemic."@en, "Мера, принятая для безопасной работы основных медицинских служб во время пандемии COVID-19."@ru .

society:LivesSaved a rdfs:Class ;
    rdfs:label "Lives saved"@en, "Спасённые жизни"@ru ;
    rdfs:comment "Number of maternal and child lives saved by an intervention thanks to mitigation measures."@en, "Число жизней матерей и детей, спасённых вмешательством благодаря мерам смягчения."@ru .

#-------------------------------------------
# Object Properties
#-------------------------------------------

society:hasLivesSaved a rdf:Property ;
    rdfs:domain society:HealthcareIntervention ;
    rdfs:range society:LivesSaved ;
    rdfs:label "Lives saved"@en, "Спасённые жизни"@ru ;
    rdfs:comment "Links an intervention with the lives it saved thanks to mitigation."@en, "Связывает вмешательство с жизнями, спасёнными благодаря мерам смягчения."@ru .

society:hasLivesSavedByStrategy a rdf:Property ;
    rdfs:domain society:HealthcareIntervention ;
    rdfs:range society:MitigationStrategy ;
    rdfs:label "Lives saved by strategy"@en, "Жизни, спасённые стратегиями"@ru ;
    rdfs:comment "Links the intervention to mitigation strategies, with an indication of the number of lives saved."@en, "Связывает вмешательство со стратегиями смягчения для указания с количества спесенных жизней."@ru .

#-------------------------------------------
# Datatype Properties
#-------------------------------------------

society:listNumber a rdf:Property ;
    rdfs:domain society:HealthcareIntervention ;
    rdfs:range xsd:integer ;
    rdfs:label "LiST number"@en, "Номер в LiST"@ru ;
    rdfs:comment "Identifier of the intervention in the LiST model."@en, "Идентификатор вмешательства в модели LiST."@ru .

society:interventionNumber a rdf:Property ;
    rdfs:domain society:HealthcareIntervention ;
    rdfs:range xsd:integer ;
    rdfs:label "Intervention number"@en, "Номер вмешательства"@ru ;
    rdfs:comment "Sequential number of the intervention within the workbook."@en, "Порядковый номер вмешательства в расчётной книге."@ru .

society:category a rdf:Property ;
    rdfs:domain society:HealthcareIntervention ;
    rdfs:range xsd:string ;
    rdfs:label "Category"@en, "Категория"@ru ;
    rdfs:comment "Broad area of care to which the intervention belongs, such as family planning or antenatal care."@en, "Область помощи, к которой относится вмешательство, например планирование семьи или наблюдение беременных."@ru .

society:interventionName a rdf:Property ;
    rdfs:domain society:HealthcareIntervention ;
    rdfs:range xsd:string ;
    rdfs:label "Intervention name"@en, "Название вмешательства"@ru ;
    rdfs:comment "Name of the maternal, newborn or child health intervention."@en, "Название вмешательства в области здоровья матерей, новорождённых и детей."@ru .

society:selected a rdf:Property ;
    rdfs:domain society:HealthcareIntervention ;
    rdfs:range xsd:boolean ;
    rdfs:label "Selected"@en, "Выбрано"@ru ;
    rdfs:comment "Flag indicating whether the intervention is included in the analysis."@en, "Признак того, включено ли вмешательство в анализ."@ru .

society:strategyName a rdf:Property ;
    rdfs:domain society:MitigationStrategy ;
    rdfs:range xsd:string ;
    rdfs:label "Strategy name"@en, "Название стратегии"@ru ;
    rdfs:comment "Name of the measure taken to keep health services running during the pandemic."@en, "Название меры, принятой для работы медицинских служб во время пандемии."@ru .

society:strategyCategory a rdf:Property ;
    rdfs:domain society:MitigationStrategy ;
    rdfs:range xsd:string ;
    rdfs:label "Strategy category"@en, "Категория стратегии"@ru ;
    rdfs:comment "Group of mitigation strategies, such as general measures or family planning."@en, "Группа стратегий смягчения, например общие меры или планирование семьи."@ru .

society:livesSavedByStrategy a rdf:Property ;
    rdfs:domain society:MitigationStrategy ;
    rdfs:range xsd:decimal ;
    rdfs:label "Lives saved by strategy"@en, "Жизни, спасённые стратегией"@ru ;
    rdfs:comment "Number of lives saved for the intervention that are attributed to the strategy."@en, "Число жизней, спасённых в рамках вмешательства и приписанных стратегии."@ru .

society:maternalLivesSaved a rdf:Property ;
    rdfs:domain society:LivesSaved ;
    rdfs:range xsd:integer ;
    rdfs:label "Maternal lives saved"@en, "Спасено жизней матерей"@ru ;
    rdfs:comment "Number of maternal lives saved."@en, "Число спасённых жизней матерей."@ru .

society:childLivesSaved a rdf:Property ;
    rdfs:domain society:LivesSaved ;
    rdfs:range xsd:integer ;
    rdfs:label "Child lives saved"@en, "Спасено жизней детей"@ru ;
    rdfs:comment "Number of child lives saved."@en, "Число спасённых жизней детей."@ru .
