@prefix eco: <http://example.org/economy#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# ==================== Classes ====================

eco:DebtReliefObservation a rdfs:Class ;
    rdfs:label "Debt relief observation"@en, "Наблюдение за списанием долгов"@ru ;
    rdfs:comment "Debt relief order rates per 10,000 adults by location, England and Wales, 2011 to 2021"@en, "Показатели списания долгов на 10 000 взрослых по месту жительства, Англия и Уэльс, 2011–2021 гг."@ru .

eco:Location a rdfs:Class ;
    rdfs:label "Location"@en, "Территория"@ru ;
    rdfs:comment "Geographic area identified by its code"@en, "Географическая территория, определяемая своим кодом"@ru .

# ==================== Object Properties ====================

eco:hasObservation a rdf:Property ;
    rdfs:domain eco:Location ;
    rdfs:range eco:DebtReliefObservation ;
    rdfs:label "Observation"@en, "Наблюдение"@ru ;
    rdfs:comment "Statistical observation made for this geographic area"@en, "Статистическое наблюдение, проведённое по этой территории"@ru .

# ==================== Datatype Properties ====================

eco:year a rdf:Property ;
    rdfs:domain eco:DebtReliefObservation ;
    rdfs:range xsd:gYear ;
    rdfs:label "Year"@en, "Год"@ru ;
    rdfs:comment "Calendar year of observation"@en, "Календарный год наблюдения"@ru .

eco:code a rdf:Property ;
    rdfs:domain eco:Location ;
    rdfs:range xsd:string ;
    rdfs:label "Code"@en, "Код"@ru ;
    rdfs:comment "The geographic code of location"@en, "Географический код местоположения"@ru .

eco:locationName a rdf:Property ;
    rdfs:domain eco:Location ;
    rdfs:range xsd:string ;
    rdfs:label "Location name"@en, "Название территории"@ru ;
    rdfs:comment "The name of the geographic area"@en, "Название географической территории"@ru .

eco:geography a rdf:Property ;
    rdfs:domain eco:Location ;
    rdfs:range xsd:string ;
    rdfs:label "Geography"@en, "География"@ru ;
    rdfs:comment "The type of geographic area"@en, "Тип географической области"@ru .

eco:debtReliefOrderRate a rdf:Property ;
    rdfs:domain eco:DebtReliefObservation ;
    rdfs:range xsd:decimal ;
    rdfs:label "Rate of debt relief orders"@en, "Уровень распоряжений о списании долгов"@ru ;
    rdfs:comment "The rate of debt relief orders per 10,000 adults for a given year"@en, "Показатель постановлений об освобождении от долгов на 10 000 взрослых за данный год"@ru .
